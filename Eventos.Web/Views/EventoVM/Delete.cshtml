@model Eventos.Web.Models.EventoVM

@{
    ViewData["Title"] = "Delete";
}

<h1>Evento</h1>

<h3>Quieres borrar el evento?</h3>
<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Nombre del evento
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.NombreEvento)
        </dd>
    </dl>
    <dl class="row">
        <dt class = "col-sm-2">
            Fecha del evento
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.FechaEvento)
        </dd>
    </dl>
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <button type="submit" value="Delete" class="btn btn-danger">Borrar</button> |
        <a asp-action="Index">Volver</a>
    </form>
</div>
